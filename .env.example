# Optional. Without it the app runs fully in memory.
# Example: postgres://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=
# Set to "1" to skip live DNS/website checks (offline demos, CI)
OFFLINE_CHECKS=
# Minutes between scheduled scrapes (default 30, minimum 5)
SCRAPE_INTERVAL_MINUTES=
# Set to "0" to switch off the built-in schedule
SCRAPER_ENABLED=
# Searches created on first start: "industry@place; industry@place". Leave unset for the defaults.
# SCRAPER_SEARCHES=plumbing@Austin, Texas; dental@Denver, Colorado
